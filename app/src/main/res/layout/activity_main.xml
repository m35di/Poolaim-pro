<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp"
        android:gravity="center">

        <TextView
            android:text="🎱 PoolAim Pro"
            android:textColor="#00FF00"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:text="Aim + Predictor Tool"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:id="@+id/status"
            android:text="وضعیت: ---"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="15dp"
            android:background="#1A1A1A"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/grant_btn"
            android:text="🔓 دسترسی Overlay"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/start_btn"
            android:text="▶️ فعال‌سازی"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#00AA00"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/stop_btn"
            android:text="⏹️ خاموش کردن"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#AA0000"
            android:textColor="#FFFFFF"/>

        <TextView
            android:text="راهنما:\n1. Overlay رو مجاز کن\n2. فعال‌سازی بزن\n3. برو تو بازی\n4. 🎯 رو بزن\n5. 👆 برای انتخاب توپ\n6. L/T/B برای تغییر حالت\n7. 🎨 برای رنگ\n8. ➖ برای ضخامت\n9. ⬆⬇ برای جابه‌جایی cue"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginTop="30dp"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>
</ScrollView>
